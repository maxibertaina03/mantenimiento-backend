# =====================================================================
# Backend env vars - copiar a .env y completar
# =====================================================================

# --- Runtime ------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_PREFIX=api
API_VERSION=1

# --- CORS ---------------------------------------------------------------------
# Coma-separado, sin espacios
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=debug

# --- Database -----------------------------------------------------------------
# Docker setup (puerto 5433):
#   docker run -d --name cmms_postgres \
#     -e POSTGRES_USER=cmms_user -e POSTGRES_PASSWORD=cmms_password \
#     -e POSTGRES_DB=postgres -p 5433:5432 postgres:16-alpine
#   docker exec cmms_postgres psql -U cmms_user -d postgres -c "CREATE EXTENSION IF NOT EXISTS citext;"
DATABASE_URL=postgresql://cmms_user:cmms_password@127.0.0.1:5433/postgres?schema=public

# --- Clerk (obtener desde https://dashboard.clerk.com) ------------------------
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_JWT_ISSUER=https://your-clerk-frontend-api.clerk.accounts.dev

# --- Rate limiting ------------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# --- Multi-tenant (preparado, no activo) --------------------------------------
MULTI_TENANT_ENABLED=false
