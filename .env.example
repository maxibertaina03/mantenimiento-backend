# =====================================================================
# Backend env vars - copiar a .env y completar
# =====================================================================

# --- Runtime ------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_PREFIX=api
API_VERSION=1

# --- CORS ---------------------------------------------------------------------
# Coma-separado, sin espacios
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=debug

# --- Database -----------------------------------------------------------------
DATABASE_URL=postgresql://mantenimiento:mantenimiento@localhost:5432/mantenimiento?schema=public

# --- Clerk (obtener desde https://dashboard.clerk.com) ------------------------
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_JWT_ISSUER=https://your-clerk-frontend-api.clerk.accounts.dev

# --- Rate limiting ------------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# --- Multi-tenant (preparado, no activo) --------------------------------------
MULTI_TENANT_ENABLED=false
